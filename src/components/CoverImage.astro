---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import logo from '@/assets/brand/logo.png';

/* Renders a cover image, or an elegant branded placeholder when none exists. */
interface Props {
  image?: ImageMetadata;
  alt: string;
  class?: string;
  sizes?: string;
  eager?: boolean;
}
const { image, alt, class: className = '', sizes = '(min-width:640px) 45vw, 90vw', eager = false } = Astro.props;
---

{image ? (
  <Image
    src={image}
    alt={alt}
    widths={[400, 700, 1000]}
    sizes={sizes}
    class={className}
    loading={eager ? 'eager' : 'lazy'}
  />
) : (
  <div class:list={['relative flex items-center justify-center bg-gradient-to-br from-brand to-brand-deep', className]} role="img" aria-label={alt}>
    <div class="absolute inset-0 opacity-[0.07]" style="background-image:radial-gradient(circle at 30% 20%, #fff 0, transparent 40%)"></div>
    <Image src={logo} alt="" width={96} height={96} class="w-1/4 max-w-24 opacity-90 drop-shadow" />
  </div>
)}
