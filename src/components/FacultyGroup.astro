---
/* One Faculty & Staff group rendered as a sub-page: a compact hero, the
   switcher SectionNav, and the grid of people cards. Shared by the two
   /faculty pages (Teaching faculty is the /faculty landing — no overview hub). */
import PageHero from '@/components/PageHero.astro';
import SectionNav from '@/components/SectionNav.astro';
import Section from '@/components/Section.astro';
import FacultyCard from '@/components/FacultyCard.astro';
import { facultyNav, type Person } from '@/data/faculty';
import { getSingle } from '@/lib/images';

interface Props {
  title: string;
  people: Person[];
}
const { title, people } = Astro.props;
const hero = getSingle('heroes', 'faculty');
---

<PageHero
  size="compact"
  kicker="Faculty & Staff"
  title={title}
  image={hero}
  imageAlt="GCE faculty and staff group photo"
  imagePosition="center 70%"
/>
<SectionNav items={facultyNav} current={Astro.url.pathname} label="Faculty & Staff" />

<Section space="md">
  <h2 class="sr-only">{title}</h2>
  <div class="grid gap-6 grid-cols-2 lg:grid-cols-4">
    {people.map((p) => <FacultyCard person={p} />)}
  </div>
</Section>
