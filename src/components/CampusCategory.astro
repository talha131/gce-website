---
/* One Campus category rendered as a sub-page: a compact campus hero, the
   category-switcher SectionNav, and the grid of that category's facility cards.
   Shared by the four /campus category pages (Academic is the /campus landing —
   there is deliberately no overview hub). */
import PageHero from '@/components/PageHero.astro';
import SectionNav from '@/components/SectionNav.astro';
import Section from '@/components/Section.astro';
import FacilityCard from '@/components/FacilityCard.astro';
import { facilities, campusNav, type Facility } from '@/data/facilities';
import { getSingle } from '@/lib/images';

interface Props {
  category: Facility['category'];
}
const { category } = Astro.props;
const hero = getSingle('heroes', 'campus');
const items = facilities.filter((f) => f.category === category);
---

<PageHero
  size="compact"
  kicker="Campus & Facilities"
  title={category}
  image={hero}
  imageAlt="Government College of Education campus"
/>
<SectionNav items={campusNav} current={Astro.url.pathname} label="Campus" />

<Section space="md">
  <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {items.map((f, i) => <FacilityCard facility={f} delay={(i % 3) * 70} />)}
  </div>
</Section>
