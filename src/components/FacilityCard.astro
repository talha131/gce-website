---
import CoverImage from './CoverImage.astro';
import { getCover } from '@/lib/images';
import type { Facility } from '@/data/facilities';

interface Props {
  facility: Facility;
  delay?: number;
}
const { facility, delay = 0 } = Astro.props;
const cover = getCover('facilities', facility.slug);
const href = `/campus/${facility.slug}`;
---

<article class="card card-hover overflow-hidden flex flex-col" data-reveal style={delay ? `--reveal-delay:${delay}ms` : undefined}>
  <a href={href} class="relative block overflow-hidden aspect-[16/10]">
    <CoverImage
      image={cover}
      alt={facility.name}
      class="h-full w-full object-cover transition-transform duration-500 hover:scale-[1.05]"
      sizes="(min-width:1024px) 30vw, (min-width:640px) 45vw, 90vw"
    />
    {facility.badge && (
      <span class="absolute top-3 left-3 text-xs font-semibold px-2.5 py-1 rounded-full bg-gold text-brand-950 shadow">
        {facility.badge}
      </span>
    )}
  </a>
  <div class="p-5 flex-1 flex flex-col">
    <h3 class="!text-lg !leading-snug">
      <a href={href} class="hover:text-brand transition-colors">{facility.name}</a>
    </h3>
    <p class="mt-2 text-sm text-ink-soft leading-relaxed flex-1">{facility.blurb}</p>
    <a href={href} class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-brand hover:gap-2.5 transition-all">
      Explore
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
  </div>
</article>
