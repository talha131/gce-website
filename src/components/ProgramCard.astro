---
import type { Program } from '@/data/programs';

interface Props {
  program: Program;
  delay?: number;
}
const { program, delay = 0 } = Astro.props;
const href = `/programs/${program.slug}`;
const isEvening = program.shift === 'Evening';
const facts = [
  { label: 'Shift', value: program.shift },
  { label: 'Duration', value: program.duration },
  { label: 'Semesters', value: String(program.semesters) },
];
---

<article
  class="card card-hover p-6 md:p-7 flex flex-col h-full"
  data-reveal
  style={delay ? `--reveal-delay:${delay}ms` : undefined}
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="!text-xl !leading-snug">
      <a href={href} class="hover:text-brand transition-colors">{program.name}</a>
    </h3>
    <span class:list={[
      'shrink-0 text-xs font-semibold px-2.5 py-1 rounded-full',
      isEvening ? 'bg-gold/20 text-gold-deep' : 'bg-brand-tint text-brand',
    ]}>{program.shift}</span>
  </div>

  <p class="mt-3 text-sm text-ink-soft leading-relaxed flex-1">{program.tagline}</p>

  <dl class="mt-5 grid grid-cols-3 gap-2 border-t border-line pt-4">
    {facts.map((f) => (
      <div>
        <dt class="text-[0.68rem] uppercase tracking-wider text-ink-soft">{f.label}</dt>
        <dd class="mt-0.5 font-display font-semibold text-brand-deep">{f.value}</dd>
      </div>
    ))}
  </dl>

  <div class="mt-5 flex items-center justify-between gap-3">
    <span class="text-xs text-ink-soft">Entry: {program.entry}</span>
    <a href={href} class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand hover:gap-2.5 transition-all">
      Details
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
  </div>
</article>
