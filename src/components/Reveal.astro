---
/* Wraps children in a scroll-reveal element with an optional stagger delay. */
interface Props {
  /** Stagger delay in ms. */
  delay?: number;
  as?: keyof HTMLElementTagNameMap;
  class?: string;
}
const { delay = 0, as = 'div', class: className = '' } = Astro.props;
const Tag = as;
---

<Tag data-reveal style={delay ? `--reveal-delay:${delay}ms` : undefined} class={className}>
  <slot />
</Tag>
