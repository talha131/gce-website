---
/* Renders an Urdu poem/statement RTL in Nastaliq, with an English label. */
interface Props {
  title: string;
  titleEn: string;
  author?: string;
  authorEn?: string;
  couplets: string[][];
}
const { title, titleEn, author, authorEn, couplets } = Astro.props;
---

<article class="card p-7 md:p-9 h-full flex flex-col" data-reveal>
  <header class="flex items-baseline justify-between gap-3 border-b border-line pb-4">
    <h3 lang="ur" dir="rtl" class="!text-brand-deep text-2xl md:text-3xl !leading-normal">{title}</h3>
    <span class="text-xs uppercase tracking-[0.14em] text-gold-deep font-semibold shrink-0">{titleEn}</span>
  </header>

  <div lang="ur" dir="rtl" class="mt-5 flex-1 space-y-5 text-[1.35rem] md:text-2xl text-ink">
    {couplets.map((lines) => (
      <p class="leading-[2.4]">
        {lines.map((line, i) => (
          <>
            {line}
            {i < lines.length - 1 && <br />}
          </>
        ))}
      </p>
    ))}
  </div>

  {author && (
    <footer class="mt-6 pt-4 border-t border-line text-left flex items-baseline justify-between gap-3">
      <span lang="ur" dir="rtl" class="text-gold-deep text-lg">{author}</span>
      {authorEn && <span class="text-xs text-ink-soft">{authorEn}</span>}
    </footer>
  )}
</article>
