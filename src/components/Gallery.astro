---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  images: ImageMetadata[];
  /** Base alt text; each image gets "<altBase> — photo N". */
  altBase: string;
  columns?: 2 | 3 | 4;
}

const { images, altBase, columns = 3 } = Astro.props;

// Pre-compute an optimized large version of each image for the lightbox.
const large = await Promise.all(
  images.map((img) => getImage({ src: img, width: 1600, format: 'webp' })),
);

const colClass = {
  2: 'sm:grid-cols-2',
  3: 'sm:grid-cols-2 lg:grid-cols-3',
  4: 'sm:grid-cols-2 lg:grid-cols-4',
}[columns];
---

{images.length > 0 && (
  <div class="gallery" data-gallery>
    <ul class:list={['grid grid-cols-1 gap-4', colClass]}>
      {images.map((img, i) => (
        <li data-reveal style={`--reveal-delay:${Math.min(i, 6) * 60}ms`}>
          <button
            type="button"
            class="group block w-full overflow-hidden rounded-[var(--radius)] border border-line bg-surface shadow-card focus-visible:outline-offset-4 aspect-[4/3]"
            data-full={large[i].src}
            data-alt={`${altBase} — photo ${i + 1}`}
            aria-label={`View ${altBase} — photo ${i + 1} full size`}
          >
            <Image
              src={img}
              alt={`${altBase} — photo ${i + 1}`}
              widths={[300, 500, 700]}
              sizes="(min-width:1024px) 30vw, (min-width:640px) 45vw, 90vw"
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.06]"
              loading="lazy"
            />
          </button>
        </li>
      ))}
    </ul>

    <dialog
      class="lightbox backdrop:bg-brand-950/80 bg-transparent p-0 max-w-none w-full h-full max-h-full"
      data-lightbox
      aria-label={`${altBase} image viewer`}
    >
      <div class="fixed inset-0 flex items-center justify-center p-4 sm:p-8">
        <button type="button" class="lb-btn absolute top-4 right-4" data-lb-close aria-label="Close viewer">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"/></svg>
        </button>
        <button type="button" class="lb-btn absolute left-4 top-1/2 -translate-y-1/2" data-lb-prev aria-label="Previous image">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 5l-7 7 7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button type="button" class="lb-btn absolute right-4 top-1/2 -translate-y-1/2" data-lb-next aria-label="Next image">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <figure class="max-w-[92vw] max-h-[86vh]">
          <img data-lb-img src="" alt="" class="max-w-[92vw] max-h-[80vh] w-auto h-auto object-contain rounded-lg shadow-lift" />
          <figcaption data-lb-caption class="mt-3 text-center text-sm text-white/80"></figcaption>
        </figure>
      </div>
    </dialog>
  </div>
)}

<style>
  .lb-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    color: #fff;
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(6px);
    transition: background-color .2s ease, transform .2s ease;
    z-index: 2;
  }
  .lb-btn:hover { background: rgba(255, 255, 255, 0.28); transform: scale(1.05); }
  dialog.lightbox[open] { display: block; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const dialog = root.querySelector<HTMLDialogElement>('[data-lightbox]');
    const img = root.querySelector<HTMLImageElement>('[data-lb-img]');
    const caption = root.querySelector<HTMLElement>('[data-lb-caption]');
    const triggers = Array.from(root.querySelectorAll<HTMLButtonElement>('button[data-full]'));
    if (!dialog || !img || !caption) return;

    let index = 0;
    const show = (i: number) => {
      index = (i + triggers.length) % triggers.length;
      const btn = triggers[index];
      img.src = btn.dataset.full ?? '';
      img.alt = btn.dataset.alt ?? '';
      caption.textContent = `${index + 1} / ${triggers.length}`;
    };

    triggers.forEach((btn, i) =>
      btn.addEventListener('click', () => {
        show(i);
        dialog.showModal();
      }),
    );

    root.querySelector('[data-lb-close]')?.addEventListener('click', () => dialog.close());
    root.querySelector('[data-lb-next]')?.addEventListener('click', () => show(index + 1));
    root.querySelector('[data-lb-prev]')?.addEventListener('click', () => show(index - 1));

    // Click on the backdrop (outside the figure) closes.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(index + 1);
      if (e.key === 'ArrowLeft') show(index - 1);
    });
  });
</script>
