---
import { Image } from 'astro:assets';
import Monogram from './Monogram.astro';
import { getSingle } from '@/lib/images';
import type { Person } from '@/data/faculty';

interface Props {
  person: Person;
}
const { person } = Astro.props;
const photo = getSingle('faculty', person.folder);
---

<article class="card card-hover overflow-hidden flex flex-col" data-reveal>
  <div class="aspect-[4/5] bg-brand-tint overflow-hidden">
    {photo ? (
      <Image
        src={photo}
        alt={`Portrait of ${person.name}`}
        widths={[240, 380]}
        sizes="(min-width:1024px) 22vw, (min-width:640px) 45vw, 90vw"
        class="h-full w-full object-cover"
        style={person.focus ? `object-position:${person.focus}` : undefined}
        loading="lazy"
      />
    ) : (
      <Monogram name={person.name} class="h-full w-full text-3xl" />
    )}
  </div>
  <div class="p-5 flex-1 flex flex-col">
    <h3 class="!text-lg !leading-snug text-brand-deep">{person.name}</h3>
    {person.title && <p class="mt-1 text-sm font-semibold text-gold-deep">{person.title}</p>}
    {person.quals.length > 0 && (
      <ul class="mt-3 space-y-1 text-sm text-ink-soft">
        {person.quals.map((q) => (
          <li class="flex gap-2">
            <span class="text-gold mt-1.5 h-1 w-1 rounded-full bg-current shrink-0" aria-hidden="true"></span>
            <span>{q}</span>
          </li>
        ))}
      </ul>
    )}
    {(person.email || person.website) && (
      <div class="mt-4 pt-3 border-t border-line space-y-1.5 text-sm">
        {person.email && (
          <a href={`mailto:${person.email}`} class="flex items-center gap-2 text-brand hover:text-brand-deep break-all">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            <span>{person.email}</span>
          </a>
        )}
        {person.website && (
          <a href={`https://${person.website}`} target="_blank" rel="noopener" class="flex items-center gap-2 text-brand hover:text-brand-deep break-all">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a15 15 0 0 1 0 18 15 15 0 0 1 0-18Z"/></svg>
            <span>{person.website}</span>
          </a>
        )}
      </div>
    )}
    {/* Former-member footer: pinned to the card bottom (mt-auto) so the status
        reads as a closing note rather than competing with the name. Neutral
        grey on purpose — gold reads as an award everywhere else on this site. */}
    {person.former && (
      <div class="mt-auto pt-4 flex flex-wrap items-center gap-x-2.5 gap-y-1 border-t border-line">
        <span class="rounded-full bg-ink/10 px-2.5 py-1 text-xs font-semibold text-ink">
          {person.former.label}
        </span>
        <span class="text-sm font-medium text-ink-soft">At GCE {person.former.years}</span>
      </div>
    )}
  </div>
</article>
