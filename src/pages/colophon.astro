---
import { Image } from 'astro:assets';
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/Section.astro';
import Reveal from '@/components/Reveal.astro';
import Monogram from '@/components/Monogram.astro';
import { contributors } from '@/data/contributors';
import { getSingle } from '@/lib/images';
---

<Layout
  title="Colophon"
  description="Designed & developed by Talha Mansoor (talhamansoor.com) — the colophon and credits for the Government College of Education website, with its student team."
>
  <PageHero
    kicker="Colophon"
    title="Made with <span class='accent-italic !text-gold-bright'>care</span>, by our community"
    lead="Built by the students of Government College of Education, with faculty. Here's who made it happen."
  />

  <!-- Student contributors — orbiting cards (pauses on hover) -->
  <Section kicker="The Team" title="The students behind this site">
    <p class="mx-auto max-w-2xl text-center text-lg text-ink-soft leading-relaxed mb-8" data-reveal>
      This site is the students' own — it exists because of their work. It stays in their hands,
      too: for any correction or update, reach out to them directly.
    </p>
    <div class="orbit-stage" data-reveal>
      <div class="orbit">
        {contributors.map((c, i) => {
          const photo = getSingle('contributors', c.folder);
          return (
            <div class="slot" style={`--a:${i * (360 / contributors.length)}deg`}>
              <div class="spinner">
                <a href={c.linktree} target="_blank" rel="noopener" class="cc">
                  {photo ? (
                    <Image class="cc__img" src={photo} widths={[480, 720]} sizes="560px" alt={`Portrait of ${c.name}`} loading="lazy" />
                  ) : (
                    <Monogram name={c.name} class="absolute inset-0 h-full w-full text-3xl" />
                  )}
                  <div class="cc__scrim"></div>
                  <div class="cc__meta">
                    <h3 class="cc__name">{c.name}</h3>
                    <p class="cc__batch">{c.batch}</p>
                    <span class="cc__link">LinkTree ↗</span>
                  </div>
                </a>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </Section>

  <!-- Developer -->
  <Section tone="tint" kicker="Development" title="Built &amp; led by Talha Mansoor" space="md">
    <div class="grid lg:grid-cols-2 gap-8 items-start">
      <Reveal class="space-y-4 text-lg text-ink-soft leading-relaxed">
        <p>
          This website was designed, developed and led by
          <a href="https://talhamansoor.com" class="text-brand font-semibold underline underline-offset-2 hover:text-brand-deep">Talha Mansoor</a>,
          a faculty member at GCE and a software developer, working alongside the student
          contributors above.
        </p>
        <p>
          Talha also builds <a href="https://ustadji.app" class="text-brand font-semibold underline underline-offset-2 hover:text-brand-deep">ustadji.app</a>,
          an education platform — part of an ongoing commitment to using technology in the
          service of teaching and learning.
        </p>
      </Reveal>

      <Reveal delay={120} class="card p-7">
        <h3 class="!text-xl">Built with</h3>
        <ul class="mt-4 space-y-2.5 text-ink-soft">
          <li class="flex items-center gap-2.5"><span class="h-1.5 w-1.5 rounded-full bg-gold"></span> Astro — fast, content-driven static site</li>
          <li class="flex items-center gap-2.5"><span class="h-1.5 w-1.5 rounded-full bg-gold"></span> Tailwind CSS — with a single-file theme</li>
          <li class="flex items-center gap-2.5"><span class="h-1.5 w-1.5 rounded-full bg-gold"></span> Self-hosted Fraunces, Inter &amp; Noto Nastaliq Urdu</li>
          <li class="flex items-center gap-2.5"><span class="h-1.5 w-1.5 rounded-full bg-gold"></span> Deployed as static output on Netlify</li>
        </ul>
        <div class="mt-6 pt-5 border-t border-line flex gap-3">
          <a href="https://talhamansoor.com" class="btn btn-primary !py-2.5 !px-5 text-sm">talhamansoor.com</a>
          <a href="https://ustadji.app" class="btn btn-ghost !py-2.5 !px-5 text-sm">ustadji.app</a>
        </div>
      </Reveal>
    </div>
  </Section>
</Layout>

<style>
  /* Orbit — cards circle continuously and pause on hover/focus */
  .orbit-stage { display: flex; justify-content: center; padding: 3rem 0 2.5rem; }
  .orbit {
    position: relative;
    width: min(680px, 92vw);
    aspect-ratio: 1;
    animation: orbit-spin 40s linear infinite;
  }
  .orbit:hover, .orbit:focus-within { animation-play-state: paused; }

  .slot {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 206px;
    height: 274px;
    margin: -137px 0 0 -103px;
    --r: clamp(150px, 34vw, 236px);
    transform: rotate(var(--a)) translate(var(--r)) rotate(calc(var(--a) * -1));
  }
  .slot:hover, .slot:focus-within { z-index: 10; }

  .spinner {
    width: 100%;
    height: 100%;
    animation: orbit-spin 40s linear infinite reverse;
  }
  .orbit:hover .spinner, .orbit:focus-within .spinner { animation-play-state: paused; }

  @keyframes orbit-spin { to { transform: rotate(360deg); } }

  /* Full-bleed card */
  .cc {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: #0b0322;
    box-shadow: var(--shadow-lift);
    transition: transform .35s ease, box-shadow .35s ease;
  }
  .cc:hover, .cc:focus-visible { transform: translateY(-7px); }
  .cc:focus-visible { outline: 3px solid var(--gold-bright); outline-offset: 2px; }

  .cc :global(img.cc__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(2.72);
    transform-origin: center 46%;
    transition: transform .5s ease;
  }
  .cc:hover :global(img.cc__img) { transform: scale(2.84); }

  .cc__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      #0b0322 3%,
      color-mix(in srgb, #0b0322 55%, transparent) 30%,
      transparent 56%
    );
  }
  .cc__meta {
    position: absolute; left: 0; right: 0; bottom: 0; padding: 1rem;
    transition: transform .35s ease;
  }
  .cc:hover .cc__meta, .cc:focus-visible .cc__meta { transform: translateY(-3px); }

  .cc__name { font-family: var(--font-display); font-weight: 600; font-size: 1.02rem; line-height: 1.15; color: #fff; transition: color .3s ease; }
  .cc__batch { margin-top: .14rem; font-size: .74rem; color: rgba(255,255,255,.66); transition: color .3s ease; }
  .cc__link {
    margin-top: .55rem;
    display: inline-flex; align-items: center; gap: .3rem;
    font-size: .84rem; font-weight: 700;
    color: var(--gold-bright);
    opacity: .82; transition: opacity .3s ease, color .3s ease, text-shadow .3s ease;
  }
  /* brighten the metadata on hover/focus */
  .cc:hover .cc__name, .cc:focus-visible .cc__name { color: var(--gold-bright); }
  .cc:hover .cc__batch, .cc:focus-visible .cc__batch { color: #fff; }
  .cc:hover .cc__link, .cc:focus-visible .cc__link {
    opacity: 1;
    color: #ffd766;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-shadow: 0 0 18px rgba(233, 194, 69, .55);
  }

  /* Mobile: no orbit — a centered, tappable grid of the same cards */
  @media (max-width: 767px) {
    .orbit {
      width: 100%;
      aspect-ratio: auto;
      animation: none;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 1rem;
    }
    .slot {
      position: static;
      transform: none;
      margin: 0;
      width: calc(50% - 0.5rem);
      height: auto;
      aspect-ratio: 3 / 4;
    }
    .spinner { animation: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .orbit, .spinner { animation: none; }
    .cc, .cc :global(img.cc__img), .cc__link { transition: none; }
  }
</style>
