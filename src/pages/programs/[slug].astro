---
import type { GetStaticPaths } from 'astro';
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionNav from '@/components/SectionNav.astro';
import Section from '@/components/Section.astro';
import Reveal from '@/components/Reveal.astro';
import { programs, programBySlug, programsNav } from '@/data/programs';
import { site } from '@/data/site';

export const getStaticPaths = (() =>
  programs.map((p) => ({ params: { slug: p.slug } }))) satisfies GetStaticPaths;

const { slug } = Astro.params;
const program = programBySlug(slug!)!;

const facts = [
  { label: 'Shift', value: program.shift },
  { label: 'Duration', value: program.duration },
  { label: 'Semesters', value: String(program.semesters) },
  { label: 'Entry requirement', value: program.entry },
];
const others = programs.filter((p) => p.slug !== program.slug);
---

<Layout title={program.name} description={program.tagline}>
  <PageHero kicker="Program" title={program.name} lead={program.tagline}>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/admissions" class="btn btn-gold">Admissions (November)</a>
      <a href="/programs" class="btn btn-ghost !text-white !border-white/30 hover:!bg-white/10">All programs</a>
    </div>
  </PageHero>
  <SectionNav items={programsNav} current={Astro.url.pathname} label="Programs" />

  <!-- Quick facts -->
  <div class="bg-surface border-b border-line">
    <div class="container-site py-8">
      <dl class="grid grid-cols-2 lg:grid-cols-4 gap-6">
        {facts.map((f) => (
          <div data-reveal>
            <dt class="text-xs uppercase tracking-wider text-ink-soft">{f.label}</dt>
            <dd class="mt-1 font-display text-lg font-semibold text-brand-deep">{f.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>

  <Section kicker="Overview" title="About this program" space="md">
    <div class="grid lg:grid-cols-[1.2fr_0.8fr] gap-12">
      <ul class="space-y-4" data-reveal>
        {program.overview.map((point) => (
          <li class="flex gap-3 text-lg text-ink leading-relaxed">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" class="mt-1 shrink-0 text-gold-deep" aria-hidden="true"><path d="M20 6 9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span>{point}</span>
          </li>
        ))}
      </ul>

      <Reveal class="card p-7 bg-brand-950 text-white border-0 h-fit">
        <h3 class="!text-white !text-xl flex items-center gap-3">
          <span class="h-5 w-1.5 rounded-full bg-gold"></span> Teaching Practicum
        </h3>
        <p class="mt-3 text-white/80 leading-relaxed">{program.practicum}</p>
        <div class="mt-6 pt-5 border-t border-white/15">
          <p class="text-sm text-white/70">
            Affiliated with the <span class="font-semibold text-gold-bright">{site.affiliation}</span>.
          </p>
        </div>
      </Reveal>
    </div>
  </Section>

  <!-- Other programs -->
  <Section tone="tint" kicker="Keep exploring" title="Other programs" space="md">
    <div class="grid gap-4 sm:grid-cols-3">
      {others.map((p, i) => (
        <a href={`/programs/${p.slug}`} class="card card-hover p-5 block" data-reveal style={`--reveal-delay:${i * 70}ms`}>
          <p class="font-display font-semibold text-brand-deep">{p.name}</p>
          <p class="mt-1 text-sm text-ink-soft">{p.shift} · {p.duration}</p>
        </a>
      ))}
    </div>
  </Section>
</Layout>
