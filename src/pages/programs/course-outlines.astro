---
/* Course Outlines — every published semester outline, as downloadable PDFs.
   One coloured heading box per outline set, then a card per semester. The sets
   and their order come from src/data/outlines.ts. */
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/Section.astro';
import SectionNav from '@/components/SectionNav.astro';
import { programsNav } from '@/data/programs';
import { outlineSets, outlineCourseCount } from '@/data/outlines';
import { getSingle } from '@/lib/images';

const hero = getSingle('heroes', 'programs');
---

<Layout
  title="Course Outlines"
  description="Download the course outline for every semester of the B.Ed. (Hons.) 4-year and B.Ed. 2.5-year programmes at Government College of Education, Karachi."
>
  <PageHero
    kicker="Academics"
    title="Course <span class='accent-italic !text-gold-bright'>Outlines</span>"
    lead={`Every published semester outline, free to download — ${outlineCourseCount} course outlines across our four schemes of study.`}
    image={hero}
    imageAlt="A GCE classroom"
    imagePosition="center 45%"
  >
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/programs" class="btn btn-ghost !text-white !border-white/30 hover:!bg-white/10">All programs</a>
    </div>
  </PageHero>
  <SectionNav items={programsNav} current={Astro.url.pathname} label="Programs" />

  <!-- Jump nav: anchors rather than pages, so it is built here instead of
       reusing SectionNav (which matches on pathname). Deliberately NOT sticky —
       the section-level SectionNav above owns the sticky slot at
       top-[var(--header-h)], and two bars at the same offset would overlap. -->
  <nav class="bg-surface border-b border-line" aria-label="Outline sets">
    <div class="container-site">
      <ul class="flex flex-wrap gap-2 py-3">
        {outlineSets.map((set) => (
          <li>
            <a
              href={`#${set.slug}`}
              class="inline-block rounded-full border border-line px-4 py-2 text-sm font-medium text-brand-deep hover:bg-brand-tint transition-colors"
            >
              {set.shortName}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>

  <Section space="md">
    <div class="space-y-16">
      {outlineSets.map((set, setIndex) => (
        <div id={set.slug} class="scroll-mt-36">
          <!-- Heading box -->
          <div
            class:list={[
              'rounded-[var(--radius)] px-6 py-7 md:px-9 md:py-8 text-white shadow-card',
              setIndex % 2 === 0 ? 'bg-brand' : 'bg-brand-950',
            ]}
            data-reveal
          >
            <div class="flex flex-wrap items-start justify-between gap-5">
              <div class="max-w-2xl">
                <p class="kicker !text-gold-bright">Outline set {setIndex + 1}</p>
                <h2 class="mt-3 !text-2xl md:!text-3xl text-white">{set.name}</h2>
                <p class="mt-3 text-white/75 leading-relaxed">{set.blurb}</p>
              </div>
              {set.document && (
                <a
                  href={set.document.pdf}
                  target="_blank"
                  rel="noopener"
                  class="btn btn-gold !py-3 !px-6 text-sm shrink-0"
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {set.document.label}
                </a>
              )}
            </div>
          </div>

          <!-- Semesters -->
          <div class="mt-8 grid gap-6 lg:grid-cols-2">
            {set.semesters.map((sem, i) => (
              <section class="card overflow-hidden" data-reveal style={`--reveal-delay:${(i % 2) * 70}ms`}>
                <header class="flex items-baseline justify-between gap-3 bg-brand-tint px-6 py-4 border-b border-line">
                  <h3 class="!text-lg !text-brand-deep">Semester {sem.n}</h3>
                  <span class="text-xs font-semibold uppercase tracking-wider text-gold-deeper">
                    {sem.courses.length} {sem.courses.length === 1 ? 'course' : 'courses'}
                  </span>
                </header>
                <ul class="divide-y divide-line">
                  {sem.courses.map((course) => (
                    <li>
                      <a
                        href={course.pdf}
                        target="_blank"
                        rel="noopener"
                        class="flex items-center gap-4 px-6 py-3.5 hover:bg-brand-tint/50 focus-visible:bg-brand-tint/50 transition-colors group"
                      >
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="text-brand/45 shrink-0" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
                        <span class="flex-1 min-w-0">
                          <span class="block text-ink font-medium leading-snug group-hover:text-brand transition-colors">{course.title}</span>
                          {course.code && <span class="block mt-0.5 text-xs font-semibold tracking-wider text-gold-deeper">{course.code}</span>}
                        </span>
                        <span class="text-xs font-semibold uppercase tracking-wider text-ink-soft shrink-0">PDF</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        </div>
      ))}
    </div>

    <p class="mt-14 text-sm text-ink-soft max-w-2xl" data-reveal>
      Outlines are published as they are approved. If a semester is missing here, it has not yet
      been released — check with the department, or see the
      <a href="/programs" class="text-brand underline underline-offset-2">programme pages</a>
      for what each degree covers.
    </p>
  </Section>
</Layout>
