---
/* Student Resources Center — notes, past papers and faculty publications:
   one coloured heading box per section, then a card per group of files.
   Sections and their order come from src/data/resources.ts. */
import { statSync } from 'node:fs';
import { Image, getImage } from 'astro:assets';
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/Section.astro';
import { resourceSections } from '@/data/resources';
import { getSingle } from '@/lib/images';

const hero = getSingle('heroes', 'student-resources') ?? getSingle('heroes', 'programs');

// File size under each download, so students on mobile data know what they are opening.
const sizeOf = (pdf: string) => {
  const bytes = statSync(`public${pdf}`).size;
  // MB from 999.5 KB, which would otherwise round to "1000 KB".
  return bytes >= 999_500 ? `${(bytes / 1e6).toFixed(1)} MB` : `${Math.max(1, Math.round(bytes / 1e3))} KB`;
};

// Each PDF is listed once (see resources.ts), so the count is the number of entries.
const fileCount = resourceSections.flatMap((s) => s.groups.flatMap((g) => g.files ?? [])).length;

// Resolve cover images once, with a large version to open full size.
const resolve = async (name: string) => {
  const image = getSingle('resources', name);
  if (!image) return undefined;
  const large = await getImage({ src: image, width: 1400, format: 'webp' });
  return { image, full: large.src };
};
const sections = await Promise.all(
  resourceSections.map(async (s) => ({
    ...s,
    coverImages: s.covers
      ? await Promise.all(s.covers.map(async (c) => ({ ...c, ...(await resolve(c.name)) })))
      : [],
  })),
);
---

<Layout
  title="Student Resources Center"
  description="Notes, past examination papers and faculty publications for B.Ed. students at Government College of Education, Karachi — free to read and download."
>
  <PageHero
    kicker="Study material"
    title="Student Resources <span class='accent-italic !text-gold-bright'>Center</span>"
    lead={`Notes, past papers and faculty publications — ${fileCount} documents, free to read and download.`}
    image={hero}
    imageAlt="A GCE classroom"
    imagePosition="center 45%"
  />

  <!-- Jump nav: one pill per section. Anchors, not pages, so it
       is built here rather than with SectionNav (which matches on pathname). -->
  <nav class="bg-surface border-b border-line" aria-label="Resource sections">
    <div class="container-site">
      <ul class="flex flex-wrap gap-2 py-3">
        {sections.map((s) => (
          <li>
            <a
              href={`#${s.slug}`}
              class="inline-block rounded-full border border-line px-4 py-2 text-sm font-medium text-brand-deep hover:bg-brand-tint transition-colors"
            >
              {s.shortTitle}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>

  <Section space="md">
    <div class="space-y-16">
      {sections.map((s, i) => (
        <div id={s.slug} class="scroll-mt-28">
          <!-- Heading box -->
          <div
            class:list={[
              'rounded-[var(--radius)] px-6 py-7 md:px-9 md:py-8 text-white shadow-card',
              i % 2 === 0 ? 'bg-brand' : 'bg-brand-950',
            ]}
            data-reveal
          >
            <div class="flex flex-wrap items-start justify-between gap-5">
              <div class="max-w-2xl">
                <p class="kicker !text-gold-bright">Section {i + 1}</p>
                <h2 class="mt-3 !text-2xl md:!text-3xl text-white">{s.title}</h2>
                <p class="mt-3 text-white/75 leading-relaxed">{s.blurb}</p>
              </div>
              {s.readOnline && (
                <a href={s.readOnline.href} class="btn btn-gold !py-3 !px-6 text-sm shrink-0">
                  {s.readOnline.label} →
                </a>
              )}
            </div>
          </div>

          <div class="mt-8 grid gap-6 lg:grid-cols-2 items-start">
            {s.coverImages.length > 0 && (
              <div class="card p-5 flex gap-4" data-reveal>
                {s.coverImages.map((c) =>
                  c.image ? (
                    <a href={s.readOnline?.href ?? c.full} target={s.readOnline ? undefined : '_blank'} rel={s.readOnline ? undefined : 'noopener'} class="block flex-1 overflow-hidden rounded-[var(--radius-sm)] border border-line bg-brand-tint">
                      <Image src={c.image} alt={c.alt} widths={[240, 360]} sizes="(min-width:1024px) 16vw, 42vw" class="h-full w-full object-cover aspect-[2/3] transition-transform duration-500 hover:scale-[1.03]" loading="lazy" />
                    </a>
                  ) : null,
                )}
              </div>
            )}

            {s.groups.map((g, gi) => {
              const empty = !g.files?.length;
              // A section's only card (no covers beside it) takes the full width,
              // its list split into two columns that read top to bottom.
              const wide = s.groups.length === 1 && s.coverImages.length === 0;
              const rows = Math.ceil((g.files?.length ?? 0) / 2);
              return (
                <section
                  class:list={['card overflow-hidden', wide && 'lg:col-span-2']}
                  data-reveal
                  style={`--reveal-delay:${(gi % 2) * 70}ms`}
                >
                  <header class="flex items-baseline justify-between gap-3 bg-brand-tint px-6 py-4 border-b border-line">
                    <h3 class="!text-lg !text-brand-deep">{g.title}</h3>
                    {g.files && (
                      <span class="shrink-0 text-xs font-semibold uppercase tracking-wider text-gold-deeper">
                        {g.files.length} {g.files.length === 1 ? 'file' : 'files'}
                      </span>
                    )}
                  </header>

                  {empty && (
                    <p class="px-6 py-5 text-ink-soft">
                      This folder is set up and its material is being added — check back soon.
                    </p>
                  )}

                  {g.files && g.files.length > 0 && (
                    <!-- Rows carry their own bottom rule (clipped on the last row by
                         -mb-px + the card's overflow-hidden), so it stays right in
                         the two-column layout too. -->
                    <ul
                      class:list={['-mb-px', wide && 'lg:grid lg:grid-flow-col lg:grid-cols-2']}
                      style={wide ? `grid-template-rows: repeat(${rows}, auto)` : undefined}
                    >
                      {g.files.map((f, fi) => (
                        <li class:list={['border-b border-line', wide && fi < rows && 'lg:border-r']}>
                          <a
                            href={f.pdf}
                            target="_blank"
                            rel="noopener"
                            class="flex h-full items-center gap-4 px-6 py-3.5 hover:bg-brand-tint/50 focus-visible:bg-brand-tint/50 transition-colors group"
                          >
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="text-brand/45 shrink-0" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
                            <span class="flex-1 min-w-0">
                              <span class="block text-ink font-medium leading-snug group-hover:text-brand transition-colors">{f.title}</span>
                              {f.code && <span class="block mt-0.5 text-xs font-semibold tracking-wider text-gold-deeper">{f.code}</span>}
                              {f.author && <span class="block mt-0.5 text-sm text-ink-soft">By {f.author}</span>}
                            </span>
                            <span class="text-xs font-semibold uppercase tracking-wider text-ink-soft shrink-0">PDF · {sizeOf(f.pdf)}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </section>
              );
            })}
          </div>
        </div>
      ))}
    </div>

    <p class="mt-14 text-sm text-ink-soft max-w-2xl" data-reveal>
      Material is added as faculty and students share it. Looking for your semester's
      <a href="/course-outlines" class="text-brand underline underline-offset-2">course outlines</a>?
      They have a page of their own.
    </p>
  </Section>
</Layout>
