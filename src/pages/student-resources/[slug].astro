---
/* A faculty member's publication — a book or a set of lecture handouts: who
   wrote it (with a portrait and credentials), what it is, and the whole of it
   to read online — one page-turning reader per edition or handout, switched
   with tabs. Wording, cover and quote come from the data: src/data/books.ts. */
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/Section.astro';
import Flipbook from '@/components/Flipbook.astro';
import Monogram from '@/components/Monogram.astro';
import { facultyBooks, bookBySlug } from '@/data/books';
import { educationDept } from '@/data/faculty';
import { getSingle } from '@/lib/images';

export const getStaticPaths = (() => facultyBooks.map((b) => ({ params: { slug: b.slug } }))) satisfies GetStaticPaths;

const book = bookBySlug(Astro.params.slug!)!;
const author = educationDept.find((p) => p.folder === book.authorFolder)!;
const portrait = getSingle('faculty', author.folder);
const cover = book.cover ? getSingle('resources', book.cover) : undefined;
const designation = [author.title, author.grade].filter(Boolean).join(' · ');
const lead = `${book.kind[0].toUpperCase()}${book.kind.slice(1)} by ${author.name}, ${author.title ?? 'faculty member'} at GCE — ${book.readLead}`;
const description =
  book.description ??
  `${book.title}, ${book.kind} by ${author.name} of Government College of Education, Karachi. Read the ${book.editions.map((e) => e.label.toLowerCase()).join(' and ')} online.`;
---

<Layout
  title={`${book.title} — by ${author.name}`}
  description={description}
>
  <PageHero
    kicker="Student Resources Center · Faculty publication"
    title={book.title}
    lead={lead}
  >
    {book.titleUrdu && <p lang="ur" dir="rtl" class="mt-4 w-fit text-2xl text-gold-bright">{book.titleUrdu}</p>}
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="#read" class="btn btn-gold">{book.readLabel}</a>
      <a href="/student-resources" class="btn btn-ghost !text-white !border-white/30 hover:!bg-white/10">All student resources</a>
    </div>
    {cover && (
      <Fragment slot="aside">
        <Image src={cover} alt={`${book.title} by ${author.name} — front cover`} widths={[240, 360, 480]} sizes="(min-width:1024px) 15rem, 11rem" class="w-44 lg:w-60 h-auto rounded-md shadow-lift ring-1 ring-white/15 rotate-2" loading="eager" />
      </Fragment>
    )}
  </PageHero>

  <!-- The author -->
  <Section kicker="About the author" title={author.name} space="md">
    <div class="grid gap-10 lg:grid-cols-[18rem_1fr] items-start">
      <div class="card overflow-hidden" data-reveal>
        <div class="aspect-[4/5] bg-brand-tint overflow-hidden">
          {portrait ? (
            <Image src={portrait} alt={`Portrait of ${author.name}`} widths={[288, 576]} sizes="18rem" class="h-full w-full object-cover" style={author.focus ? `object-position:${author.focus}` : undefined} />
          ) : (
            <Monogram name={author.name} class="h-full w-full text-4xl" />
          )}
        </div>
        <div class="p-5">
          <p class="font-display text-lg font-semibold text-brand-deep">{author.name}</p>
          {designation && <p class="mt-1 text-sm font-semibold text-gold-deep">{designation}</p>}
          <ul class="mt-3 space-y-1 text-sm text-ink-soft">
            {author.quals.map((q) => (
              <li class="flex gap-2">
                <span class="text-gold mt-1.5 h-1 w-1 rounded-full bg-current shrink-0" aria-hidden="true"></span>
                <span>{q}</span>
              </li>
            ))}
          </ul>
          {book.authorNote && (
            <p class="mt-4 pt-3 border-t border-line text-sm text-ink-soft">
              {book.authorNote.text}
              {book.authorNote.link && <a href={book.authorNote.link.href} class="text-brand underline underline-offset-2">{book.authorNote.link.label}</a>}
            </p>
          )}
        </div>
      </div>

      <div data-reveal>
        {book.authorQuote && (
          <figure class="rounded-[var(--radius)] border-l-4 border-gold bg-gold/10 px-6 py-5">
            <blockquote class="text-lg text-brand-deep leading-relaxed">“{book.authorQuote.text}”</blockquote>
            <figcaption class="mt-2 text-sm font-semibold text-ink-soft">— {author.name}, {book.authorQuote.source}</figcaption>
          </figure>
        )}
        <div class:list={[book.authorQuote && 'mt-6', 'space-y-4 text-lg text-ink leading-relaxed']}>
          {book.about.map((p) => <p>{p}</p>)}
        </div>

        <dl class="mt-8 grid gap-x-8 gap-y-4 sm:grid-cols-2">
          {book.credits.map((c) => (
            <div>
              <dt class="text-xs uppercase tracking-wider text-ink-soft">{c.role}</dt>
              <dd class="mt-1 font-display text-lg text-brand-deep">{c.name}</dd>
              {c.note && <dd class="text-sm text-ink-soft">{c.note}</dd>}
            </div>
          ))}
          {book.details.map((d) => (
            <div>
              <dt class="text-xs uppercase tracking-wider text-ink-soft">{d.label}</dt>
              <dd class="mt-1 text-ink">{d.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </Section>

  <!-- The reader -->
  <Section tone="tint" kicker="Read online" title={book.readLabel} space="md">
    <div id="read" class="scroll-mt-28">
      {book.editions.length > 1 && (
        <div class="mb-6 flex flex-wrap gap-2" role="tablist" aria-label={book.tabsLabel} data-book-tabs>
          {book.editions.map((e, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${e.key}`}
              aria-controls={`edition-${e.key}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              class="edition-tab"
              data-edition={e.key}
            >
              {e.label}
              {e.book.lang === 'ur' && <span lang="ur" class="ms-2">اردو</span>}
            </button>
          ))}
        </div>
      )}
      {book.editions.map((e, i) => (
        <div id={`edition-${e.key}`} role="tabpanel" aria-labelledby={`tab-${e.key}`} hidden={i > 0}>
          <Flipbook book={e.book} />
        </div>
      ))}
    </div>
  </Section>
</Layout>

<style>
  .edition-tab {
    border-radius: 999px; padding: .55rem 1.1rem; font-size: .95rem; font-weight: 600;
    border: 1px solid var(--line); background: var(--surface); color: var(--ink-soft);
    transition: color .2s ease, background-color .2s ease, border-color .2s ease;
  }
  .edition-tab:hover { color: var(--brand); }
  .edition-tab[aria-selected='true'] { background: var(--brand); border-color: var(--brand); color: #fff; }
  .edition-tab:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }
</style>

<script>
  // Edition tabs. The hidden reader starts itself the first time it is shown.
  for (const list of document.querySelectorAll<HTMLElement>('[data-book-tabs]')) {
    const tabs = [...list.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement, focus = false) => {
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
      }
      if (focus) tab.focus();
      history.replaceState(null, '', `#${tab.dataset.edition}`);
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t));
      t.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
          e.preventDefault();
          select(tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length], true);
        }
      });
    });
    // Deep link: /student-resources/<book>#urdu opens that edition.
    const fromHash = tabs.find((t) => `#${t.dataset.edition}` === location.hash);
    if (fromHash) select(fromHash);
  }
</script>
