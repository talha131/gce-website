---
import Layout from '@/layouts/Layout.astro';
import CampusCategory from '@/components/CampusCategory.astro';
import { facilities } from '@/data/facilities';
import { facilityShareImage } from '@/lib/share';

// The category's first facility — the first card on the page.
const share = facilityShareImage(facilities.find((f) => f.category === 'Grounds & Amenities')!);
---

<Layout
  title="Grounds & Amenities — Campus & Facilities"
  description="The 300-seat IT Zone, Bagh-e-Muneer memorial garden, lawns, sports grounds, parking and photocopy shop at Government College of Education, Karachi."
  image={share}
>
  <CampusCategory category="Grounds & Amenities" />
</Layout>
