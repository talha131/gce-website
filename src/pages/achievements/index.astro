---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionNav from '@/components/SectionNav.astro';
import Section from '@/components/Section.astro';
import { achievementsNav } from '@/data/achievements';
---

<Layout
  title="Achievements"
  description="GCE's achievements: the highest teaching-licence pass rate among B.Ed colleges, international conference wins, sports honours, and the ICEEC 2025 conference."
>
  <PageHero
    kicker="Achievements"
    title="Excellence, <span class='accent-italic !text-gold-bright'>recognised</span>"
    lead="From the highest teaching-licence pass rate among B.Ed colleges to international research wins and sports honours. GCE students lead."
  />
  <SectionNav items={achievementsNav} current={Astro.url.pathname} label="Achievements" />

  <!-- ====================================================== OVERVIEW HUB -->
  <Section>
    <div class="grid gap-6 sm:grid-cols-2">
      {achievementsNav.slice(1).map((item, i) => (
        <a
          href={item.href}
          class="card card-hover p-7 flex items-center justify-between gap-4 group"
          data-reveal
          style={`--reveal-delay:${i * 80}ms`}
        >
          <span class="font-display text-xl text-brand-deep">{item.label}</span>
          <span class="text-gold shrink-0 text-2xl transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </Section>
</Layout>
