---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionNav from '@/components/SectionNav.astro';
import Section from '@/components/Section.astro';
import { achievementsNav, actionResearch } from '@/data/achievements';
---

<Layout
  title="Student Research"
  description="Action-research is a standing requirement of every B.Ed. degree at Government College of Education, Karachi. Read the published student papers in full."
>
  <PageHero size="compact" kicker="Achievements" title="Research" />
  <SectionNav items={achievementsNav} current={Astro.url.pathname} label="Achievements" />

  <!-- Student research -->
  <Section kicker="Student Research" title="Action-research is part of how we teach" space="md">
    <div class="max-w-2xl -mt-6 mb-10 space-y-4 text-ink-soft" data-reveal>
      <p>
        Every B.Ed. student at GCE completes and defends an original action-research study before
        graduating. It is a standing requirement of the degree, not a one-off initiative — each
        cohort investigates a real problem in a real classroom, under a faculty supervisor, and
        publishes the result.
      </p>
      <p>
        New papers are added here as each final-semester group completes its work. The reports below
        are published in full.
      </p>
    </div>
    <ol class="space-y-4">
      {actionResearch.map((r, i) => (
        <li class="card card-hover p-6 flex flex-col sm:flex-row sm:items-center gap-4" data-reveal style={`--reveal-delay:${(i % 3) * 60}ms`}>
          <span class="font-display text-2xl font-semibold text-brand/40 shrink-0">{String(i + 1).padStart(2, '0')}</span>
          <div class="flex-1">
            <p class="font-medium text-ink leading-snug">
              <a href={r.pdf} target="_blank" rel="noopener" class="hover:text-brand focus-visible:text-brand">
                {r.title}
              </a>
            </p>
            <p class="mt-1 text-sm text-ink-soft">{r.student} · supervised by {r.supervisor} · {r.year}</p>
          </div>
          <a
            href={r.pdf}
            target="_blank"
            rel="noopener"
            class="btn btn-ghost !py-2.5 !px-5 text-sm shrink-0 self-start sm:self-auto"
            aria-label={`Read the full paper: ${r.title} (PDF)`}
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
            Read paper
          </a>
        </li>
      ))}
    </ol>
  </Section>
</Layout>
