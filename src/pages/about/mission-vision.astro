---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionNav from '@/components/SectionNav.astro';
import Section from '@/components/Section.astro';
import Reveal from '@/components/Reveal.astro';
import { aboutNav, mission, vision } from '@/data/about';
---

<Layout
  title="Mission & Vision"
  description="The mission and vision of Government College of Education, Karachi — preparing competent, caring and ethical educators, presented in English and Urdu."
>
  <PageHero size="compact" kicker="Purpose" title="Mission &amp; Vision" />
  <SectionNav items={aboutNav} current={Astro.url.pathname} label="About" />

  <!-- =================================================== MISSION & VISION -->
  <Section tone="tint" kicker="Purpose" title="Mission &amp; Vision" center>
    <div class="grid lg:grid-cols-2 gap-6 items-start">
      <!-- Mission -->
      <div class="flex flex-col gap-4">
        <Reveal class="card p-8">
          <h3 class="!text-2xl">Mission</h3>
          <p class="mt-4 text-ink-soft leading-relaxed">{mission.en}</p>
        </Reveal>
        <Reveal delay={80} class="card p-8">
          <div lang="ur" dir="rtl">
            <p class="text-gold-deep text-lg mb-2">مقصد</p>
            <p class="text-xl text-ink !leading-[2.4]">{mission.ur}</p>
          </div>
        </Reveal>
      </div>
      <!-- Vision -->
      <div class="flex flex-col gap-4">
        <Reveal delay={120} class="card p-8">
          <h3 class="!text-2xl">Vision</h3>
          <div class="mt-4 space-y-3 text-ink-soft leading-relaxed">
            {vision.en.map((p) => <p>{p}</p>)}
          </div>
        </Reveal>
        <Reveal delay={200} class="card p-8">
          <div lang="ur" dir="rtl">
            <p class="text-gold-deep text-lg mb-2">نقطۂ نظر</p>
            <p class="text-xl text-ink !leading-[2.4]">{vision.ur}</p>
          </div>
        </Reveal>
      </div>
    </div>
  </Section>
</Layout>
