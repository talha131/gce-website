---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionNav from '@/components/SectionNav.astro';
import Section from '@/components/Section.astro';
import UrduBlock from '@/components/UrduBlock.astro';
import AudioPlayer from '@/components/AudioPlayer.astro';
import { aboutNav, anthemAndDua } from '@/data/about';

const { collegeAnthem, dua, nationalAnthem } = anthemAndDua;
---

<Layout
  title="Heritage"
  description="The college anthem, dua and national anthem of Government College of Education, Karachi — the poetry that opens every gathering, in Urdu."
>
  <PageHero size="compact" kicker="About GCE" title="Heritage" />
  <SectionNav items={aboutNav} current={Astro.url.pathname} label="About" />

  <!-- ===================================================== ANTHEM & DUA -->
  <Section tone="brand" title="Anthem &amp; Dua" center>
    <div class="grid lg:grid-cols-2 gap-6">
      <div class="lg:col-span-2">
        <UrduBlock {...collegeAnthem} />
      </div>
      <UrduBlock {...dua} />
      <UrduBlock {...nationalAnthem} />
    </div>
    <div class="mt-10" data-reveal>
      <AudioPlayer src="/media/college-anthem.mp3" title="College Anthem" downloadName="GCE-College-Anthem.mp3" />
    </div>
  </Section>
</Layout>
