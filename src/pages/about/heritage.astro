---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionNav from '@/components/SectionNav.astro';
import Section from '@/components/Section.astro';
import UrduBlock from '@/components/UrduBlock.astro';
import { aboutNav, anthemAndDua } from '@/data/about';

const { collegeAnthem, dua, nationalAnthem } = anthemAndDua;
---

<Layout
  title="Heritage"
  description="The college anthem, dua and national anthem of Government College of Education, Karachi — the poetry that opens every gathering, in Urdu."
>
  <PageHero size="compact" kicker="Heritage" title="Heritage" />
  <SectionNav items={aboutNav} current={Astro.url.pathname} label="About" />

  <!-- ===================================================== ANTHEM & DUA -->
  <Section tone="brand" kicker="Heritage" title="Anthem &amp; Dua" center>
    <div class="grid lg:grid-cols-2 gap-6">
      <div class="lg:col-span-2">
        <UrduBlock {...collegeAnthem} />
      </div>
      <UrduBlock {...dua} />
      <UrduBlock {...nationalAnthem} />
    </div>
    <div class="mt-8 text-center" data-reveal>
      <p class="text-white/60 text-sm">The recorded college anthem is available from the college on request.</p>
    </div>
  </Section>
</Layout>
