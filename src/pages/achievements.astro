---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/Section.astro';
import Reveal from '@/components/Reveal.astro';
import Gallery from '@/components/Gallery.astro';
import CoverImage from '@/components/CoverImage.astro';
import StatCounter from '@/components/StatCounter.astro';
import {
  alumniLicenceHolders2025,
  honours,
  conference,
  actionResearch,
} from '@/data/achievements';
import { getCover, getGallery } from '@/lib/images';

const conferenceImages = getGallery('conference');
---

<Layout
  title="Achievements"
  description="GCE's achievements: the highest teaching-licence pass rate among B.Ed colleges, international conference wins, sports honours, and the ICEEC 2025 conference."
>
  <PageHero
    kicker="Achievements"
    title="Excellence, <span class='accent-italic !text-gold-bright'>recognised</span>"
    lead="From the highest teaching-licence pass rate among B.Ed colleges to international research wins and sports honours. GCE students lead."
  />

  <!-- Alumni licence holders -->
  <Section kicker="Alumni Success" title="Teaching-Licence Holders 2025">
    <div class="grid lg:grid-cols-[0.85fr_1.15fr] gap-10 items-start">
      <Reveal class="card p-8 bg-brand-950 text-white h-fit">
        <p class="font-display text-4xl md:text-5xl font-semibold text-gold">Highest</p>
        <p class="mt-2 text-white/80 leading-relaxed">
          pass rate among all B.Ed. colleges in the recent teaching-licence examinations.
          In 2025, our alumni sat the teaching-licence exam and earned their licences.
        </p>
      </Reveal>
      <div data-reveal>
        <p class="text-sm text-ink-soft mb-4">Congratulations to our licensed alumni:</p>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2.5">
          {alumniLicenceHolders2025.map((name) => (
            <li class="flex items-center gap-2.5 text-ink">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" class="text-gold-deep shrink-0" aria-hidden="true"><path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {name}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Section>

  <!-- Honours -->
  <Section tone="tint" kicker="Honours" title="Individual &amp; team achievements" space="md">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {honours.map((h, i) => {
        const cover = h.slug ? getCover('achievements', h.slug) : undefined;
        return (
          <article class="card card-hover overflow-hidden flex flex-col" data-reveal style={`--reveal-delay:${(i % 3) * 70}ms`}>
            <div class="aspect-[16/10] overflow-hidden bg-brand-tint">
              <CoverImage image={cover} alt={h.title} class="h-full w-full object-cover" sizes="(min-width:1024px) 30vw, 90vw" />
            </div>
            <div class="p-6 flex-1 flex flex-col">
              {h.rank && <span class="self-start text-xs font-semibold px-2.5 py-1 rounded-full bg-gold text-brand-950">{h.rank}</span>}
              <h3 class="mt-3 !text-lg !leading-snug">{h.title}</h3>
              <p class="mt-2 text-sm text-ink-soft leading-relaxed flex-1">{h.detail}</p>
            </div>
          </article>
        );
      })}
    </div>
  </Section>

  <!-- ============================================= ICEEC 2025 CONFERENCE -->
  <section id="conference" class="bg-brand-950 text-white scroll-mt-24">
    <div class="relative overflow-hidden">
      <div class="container-site relative py-20 md:py-28">
        <div class="max-w-3xl" data-reveal>
          <p class="kicker !text-gold-bright">Flagship Conference</p>
          <h2 class="mt-4 text-white text-4xl md:text-5xl">{conference.name}</h2>
          <p class="mt-3 text-xl text-gold-bright">{conference.fullName}</p>
          <p class="mt-2 text-white/60">{conference.date} · {conference.venue} · Theme: {conference.theme}</p>
          <p class="mt-6 text-lg text-white/80 leading-relaxed">{conference.summary}</p>
        </div>

        <div class="mt-12 grid grid-cols-3 gap-6 max-w-xl">
          {conference.stats.map((s, i) => (
            <StatCounter value={parseInt(s.value)} label={s.label} tone="dark" delay={i * 100} />
          ))}
        </div>

        <!-- Keynotes -->
        <div class="mt-16">
          <h3 class="!text-white !text-2xl" data-reveal>Keynote Speakers</h3>
          <div class="mt-6 grid gap-4 md:grid-cols-2">
            {conference.keynotes.map((k, i) => (
              <div class="rounded-[var(--radius)] bg-white/5 border border-white/10 p-6" data-reveal style={`--reveal-delay:${(i % 2) * 80}ms`}>
                <p class="font-display text-lg text-white">{k.name}</p>
                <p class="text-sm text-gold-bright">{k.role}</p>
                <p class="mt-3 text-sm text-white/70 italic">&ldquo;{k.topic}&rdquo;</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Panel -->
        <div class="mt-12 rounded-[var(--radius-lg)] bg-white/5 border border-white/10 p-7 md:p-9" data-reveal>
          <p class="kicker !text-gold-bright">Panel Discussion</p>
          <h3 class="!text-white !text-xl mt-3">{conference.panel.topic}</h3>
          <div class="mt-5 grid sm:grid-cols-2 gap-6">
            <div>
              <p class="text-xs uppercase tracking-wider text-white/50">Panelists</p>
              <ul class="mt-2 space-y-1.5 text-sm text-white/80">
                {conference.panel.panelists.map((p) => <li>{p}</li>)}
              </ul>
            </div>
            <div>
              <p class="text-xs uppercase tracking-wider text-white/50">Moderator</p>
              <p class="mt-2 text-sm text-white/80">{conference.panel.moderator}</p>
            </div>
          </div>
        </div>

        {conferenceImages.length > 0 && (
          <div class="mt-14">
            <h3 class="!text-white !text-2xl mb-6" data-reveal>Conference Gallery</h3>
            <Gallery images={conferenceImages} altBase="ICEEC 2025 Conference" columns={4} />
          </div>
        )}

        <p class="mt-10 text-sm text-white/55 border-t border-white/15 pt-6 max-w-3xl" data-reveal>{conference.note}</p>
      </div>
    </div>
  </section>

  <!-- Student research -->
  <Section kicker="Student Research" title="Action-research by our students" space="md">
    <p class="max-w-2xl text-ink-soft -mt-6 mb-10" data-reveal>
      A selection of action-research projects completed by GCE B.Ed. students in the Education Department.
    </p>
    <ol class="space-y-4">
      {actionResearch.map((r, i) => (
        <li class="card p-6 flex flex-col sm:flex-row sm:items-center gap-4" data-reveal style={`--reveal-delay:${(i % 3) * 60}ms`}>
          <span class="font-display text-2xl font-semibold text-brand/40 shrink-0">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <p class="font-medium text-ink leading-snug">{r.title}</p>
            <p class="mt-1 text-sm text-ink-soft">{r.student} · supervised by {r.supervisor}</p>
          </div>
        </li>
      ))}
    </ol>
  </Section>
</Layout>
