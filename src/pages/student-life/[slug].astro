---
import type { GetStaticPaths } from 'astro';
import Layout from '@/layouts/Layout.astro';
import EventDetail from '@/components/EventDetail.astro';
import { events, eventBySlug, ACADEMICS_GROUP } from '@/data/events';

// Academics events are served from /academics/[slug].
export const getStaticPaths = (() =>
  events
    .filter((e) => e.group !== ACADEMICS_GROUP)
    .map((e) => ({ params: { slug: e.slug } }))) satisfies GetStaticPaths;

const { slug } = Astro.params;
const event = eventBySlug(slug!)!;
---

<Layout title={event.name} description={event.blurb}>
  <EventDetail event={event} />
</Layout>
