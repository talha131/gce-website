---
import Layout from '@/layouts/Layout.astro';
import StudentLifeGroup from '@/components/StudentLifeGroup.astro';
import { eventsInGroup } from '@/data/events';
import { eventShareImage } from '@/lib/share';

// The group's first event — the first card on the page.
const share = eventShareImage(eventsInGroup('Workshops & Seminars')[0]);
---

<Layout
  title="Workshops & Seminars — Student Life"
  description="Career counseling, mental health, action research, AI in teaching and more — the workshops and seminars at Government College of Education, Karachi."
  image={share}
>
  <StudentLifeGroup group="Workshops & Seminars" />
</Layout>
