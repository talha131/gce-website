---
import type { GetStaticPaths } from 'astro';
import Layout from '@/layouts/Layout.astro';
import EventDetail from '@/components/EventDetail.astro';
import { eventBySlug, eventsInGroup, ACADEMICS_GROUP } from '@/data/events';

export const getStaticPaths = (() =>
  eventsInGroup(ACADEMICS_GROUP).map((e) => ({ params: { slug: e.slug } }))) satisfies GetStaticPaths;

const { slug } = Astro.params;
const event = eventBySlug(slug!)!;
---

<Layout title={event.name} description={event.blurb}>
  <EventDetail event={event} />
</Layout>
