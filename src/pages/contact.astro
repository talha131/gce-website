---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/Section.astro';
import Reveal from '@/components/Reveal.astro';
import SocialIcon from '@/components/SocialIcon.astro';
import { site, socials, transportRoutes } from '@/data/site';

// Google Maps embed for the campus (Block 15, Federal B Area). Coordinates
// resolved from the college's Google Maps share link. `output=embed` is the
// keyless embed endpoint; `mapLink` is the canonical share link for "Open in maps".
const mapSrc = 'https://www.google.com/maps?q=24.9314275,67.0807754&z=16&hl=en&output=embed';
const mapLink = 'https://maps.app.goo.gl/7eeCaKY1oFRzrdc59';
---

<Layout
  title="Contact"
  description="Get in touch with Government College of Education — Block 15, Federal B Area, Karachi. Address, email, phone, public transport routes and social links."
>
  <PageHero
    kicker="Contact"
    title="Come and <span class='accent-italic !text-gold-bright'>visit us</span>"
    lead="We're in Block 15, Federal B Area, Karachi. Reach out by email or phone, or find your route to campus below."
  />

  <Section space="md">
    <div class="grid lg:grid-cols-[1fr_1.1fr] gap-10">
      <!-- Details -->
      <div class="space-y-4">
        {[
          { label: 'Address', value: site.address.line, href: mapLink, icon: 'pin' },
          { label: 'Email', value: site.email, href: `mailto:${site.email}`, icon: 'mail' },
          { label: 'Phone', value: site.phone, href: `tel:${site.phoneHref}`, icon: 'phone' },
        ].map((c, i) => (
          <Reveal delay={i * 80} class="card card-hover">
            <a href={c.href} class="flex items-center gap-4 w-full p-6">
              <span class="h-12 w-12 rounded-xl bg-brand-tint text-brand grid place-items-center shrink-0">
                {c.icon === 'pin' && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7-6.3-7-11a7 7 0 1114 0c0 4.7-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>}
                {c.icon === 'mail' && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>}
                {c.icon === 'phone' && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.9v3a2 2 0 01-2.2 2 19.8 19.8 0 01-8.6-3 19.5 19.5 0 01-6-6 19.8 19.8 0 01-3-8.6A2 2 0 014.1 2h3a2 2 0 012 1.7c.1 1 .4 2 .7 2.9a2 2 0 01-.4 2.1L8.1 9.9a16 16 0 006 6l1.2-1.3a2 2 0 012.1-.4c1 .3 1.9.6 2.9.7a2 2 0 011.7 2z"/></svg>}
              </span>
              <span>
                <span class="block text-xs uppercase tracking-wider text-ink-soft">{c.label}</span>
                <span class="block font-medium text-ink">{c.value}</span>
              </span>
            </a>
          </Reveal>
        ))}

        <Reveal delay={240} class="card p-6">
          <p class="text-xs uppercase tracking-wider text-ink-soft mb-3">Follow us</p>
          <div class="flex flex-wrap gap-2">
            {socials.map((s) => (
              <a href={s.href} target="_blank" rel="noopener" class="social-pill gap-2 text-sm font-medium px-3.5 py-2" style={`--p:${s.color}`}>
                <SocialIcon name={s.name} />
                {s.name}
              </a>
            ))}
          </div>
        </Reveal>
      </div>

      <!-- Map -->
      <Reveal delay={120} class="card overflow-hidden min-h-[340px] flex flex-col">
        <iframe
          title="Map — Government College of Education, Federal B Area, Karachi"
          src={mapSrc}
          class="w-full flex-1 min-h-[340px] border-0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
        <a href={mapLink} target="_blank" rel="noopener" class="block text-center py-3 text-sm font-semibold text-brand bg-brand-tint hover:bg-brand-tint-2 transition-colors">
          Open in maps →
        </a>
      </Reveal>
    </div>
  </Section>

  <!-- Public transport -->
  <Section tone="tint" kicker="Getting here" title="Public transport routes" space="md">
    <p class="max-w-2xl text-ink-soft -mt-6 mb-10" data-reveal>
      Buses to the college run from across Karachi. Here are seven convenient routes.
    </p>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {transportRoutes.map((r, i) => (
        <div class="card p-5 flex items-center justify-between gap-4" data-reveal style={`--reveal-delay:${(i % 3) * 60}ms`}>
          <div>
            <p class="text-xs uppercase tracking-wider text-ink-soft">From</p>
            <p class="font-display font-semibold text-brand-deep">{r.from}</p>
          </div>
          <span class="text-sm font-semibold px-3 py-1.5 rounded-full bg-brand-tint text-brand shrink-0">{r.routes}</span>
        </div>
      ))}
    </div>
  </Section>
</Layout>
