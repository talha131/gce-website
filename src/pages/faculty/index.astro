---
import Layout from '@/layouts/Layout.astro';
import FacultyGroup from '@/components/FacultyGroup.astro';
import { educationDept } from '@/data/faculty';
import { getSingle } from '@/lib/images';
import { shareImage } from '@/lib/og';

const share = shareImage(getSingle('heroes', 'faculty'), 'GCE faculty and staff group photo', { fit: 'cover', focusY: 70 });
---

<Layout
  title="Teaching Faculty — Faculty & Staff"
  description="The teaching faculty of the Education Department at Government College of Education, Karachi — qualified, experienced educators across every subject."
  image={share}
>
  <FacultyGroup title="Teaching Faculty" people={educationDept} />
</Layout>
