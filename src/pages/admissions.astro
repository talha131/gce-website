---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/Section.astro';
import Reveal from '@/components/Reveal.astro';
import { programs } from '@/data/programs';
import { site } from '@/data/site';
import { getSingle } from '@/lib/images';

const hero = getSingle('heroes', 'admissions');
const steps = [
  'Visit the college and collect your admission form from the admin office, where staff will guide you through the programs and semesters.',
  'A date is set for the entry test or interview.',
  'After the test/interview, you receive a fee voucher from the college.',
  'Submit the fee at the selected bank.',
  'Return with the fee receipt, collect your roll number, and your admission is finalised on confirmation.',
  'Attend Orientation Day — an introduction and tour of the college — before regular classes begin.',
];

/** Two-page PDF in /public/forms: the admission form plus the attendance undertaking. */
const admissionForm = '/forms/GCE-Admission-Form.pdf';

const formContents = [
  'Your program choice — one of the four degrees offered',
  'Personal details, contact and CNIC / Form-B',
  'Academic record: SSC, HSC and any bachelor’s degree',
  'The undertaking on discipline and 75% attendance, signed by you and your parent or guardian',
];

const documents = [
  '5 passport-size photographs',
  'One copy of your Matric marksheet',
  'One copy of your Matric Board Certificate',
  'One copy of your Intermediate marksheet',
  'One copy of your Intermediate provisional certificate',
  'One copy of your CNIC',
  'One copy of Form-B (if CNIC is not yet issued)',
];
---

<Layout
  title="Admissions"
  description="Admissions to Government College of Education open every November. See the admission procedure and the documents required to apply."
>
  <PageHero
    kicker="Admissions"
    title="Your journey into <span class='accent-italic !text-gold-bright'>teaching</span> starts here"
    lead="An annual intake for all four programs. Simple, guided, and open to aspiring educators."
    image={hero}
    imageAlt="Government College of Education entrance"
  />

  <!-- Prominent November callout -->
  <div class="bg-gold text-brand-950">
    <div class="container-site py-8 text-center" data-reveal>
      <p class="font-display text-2xl md:text-3xl font-semibold">Admissions open every November</p>
      <p class="mt-2 text-brand-950/80 max-w-2xl mx-auto">
        Applications are invited each November for the upcoming session. Visit the college during
        the admission window to collect your form and begin the process.
      </p>
    </div>
  </div>

  <!-- Procedure -->
  <Section kicker="How to apply" title="The admission procedure">
    <ol class="grid gap-5 md:grid-cols-2">
      {steps.map((step, i) => (
        <li class="card p-6 flex gap-4 items-center" data-reveal style={`--reveal-delay:${(i % 2) * 80}ms`}>
          <span class="shrink-0 h-10 w-10 rounded-full bg-gold text-brand-950 grid place-items-center font-display font-bold">{i + 1}</span>
          <p class="text-ink-soft leading-relaxed">{step}</p>
        </li>
      ))}
    </ol>
  </Section>

  <!-- Admission form download -->
  <Section kicker="Before you visit" title="Download the admission form" space="md">
    <div class="grid lg:grid-cols-[1.1fr_0.9fr] gap-8 items-start">
      <Reveal>
        <p class="text-lg text-ink-soft leading-relaxed">
          The admission form and the attendance undertaking come as a single two-page PDF. Download
          it, fill it in using block letters, and sign the undertaking before you come to the college.
        </p>
        <a
          href={admissionForm}
          download="GCE-Admission-Form.pdf"
          class="btn btn-gold mt-6 !py-4 !px-7"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Download Admission Form
        </a>
        <p class="mt-3 text-sm text-ink-soft">PDF · 2 pages · form and undertaking</p>

        <p class="mt-8 rounded-[var(--radius-sm)] border-l-4 border-gold bg-gold/10 px-5 py-4 font-semibold text-brand-deep">
          Applicants are required to bring a printed copy of the completed admission form at the
          time of submitting their application.
        </p>
      </Reveal>

      <Reveal delay={120} class="card p-7">
        <h3 class="!text-xl !text-brand-deep">What the form covers</h3>
        <ul class="mt-4 space-y-2.5 text-ink-soft">
          {formContents.map((item) => (
            <li class="flex items-start gap-3">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" class="text-gold-deep mt-1 shrink-0" aria-hidden="true"><path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
        <p class="mt-6 text-sm text-ink-soft">
          Forms are also available from the admin office during the admission window.
        </p>
      </Reveal>
    </div>
  </Section>

  <!-- Documents -->
  <Section tone="tint" kicker="Checklist" title="Documents required" space="md">
    <div class="grid lg:grid-cols-2 gap-10 items-start">
      <ul class="space-y-3" data-reveal>
        {documents.map((doc) => (
          <li class="flex items-start gap-3 card p-4">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" class="text-gold-deep mt-0.5 shrink-0" aria-hidden="true"><path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span class="text-ink">{doc}</span>
          </li>
        ))}
      </ul>

      <Reveal class="card p-7 bg-brand-950 text-white">
        <h3 class="!text-gold-bright !text-xl flex items-center gap-3">
          <span class="h-5 w-1.5 rounded-full bg-gold"></span> Choose your program
        </h3>
        <p class="mt-2 text-white/70">Explore what each degree offers before you apply.</p>
        <ul class="mt-5 space-y-2">
          {programs.map((p) => (
            <li>
              <a href={`/programs/${p.slug}`} class="flex items-center justify-between gap-3 rounded-[var(--radius-sm)] px-4 py-3 bg-white/5 hover:bg-white/10 transition-colors">
                <span class="font-medium">{p.name}</span>
                <span class="text-sm text-gold-bright">{p.duration}</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="mt-6 text-sm text-white/60">Questions? <a href="/contact" class="text-gold-bright underline underline-offset-2">Contact the college</a>.</p>
      </Reveal>
    </div>
  </Section>
</Layout>
